// Documentación: https://www.prisma.io/docs
//
// La URL de conexión NO vive acá: en Prisma 7 el CLI la lee desde
// prisma.config.ts y el runtime la recibe vía driver adapter (PrismaPg),
// configurado en src/prisma/services/prisma.service.ts.

generator client {
  provider = "prisma-client"

  // El cliente se genera dentro de src/.
  output = "../src/generated/prisma"

  // Query compiler en WASM, compatible con Alpine.
  engineType = "client"
  runtime    = "nodejs"

  // Configuración para ESM y TypeScript NodeNext.
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "js"
}

datasource db {
  provider = "postgresql"
}

// ==========================================
// ROLES DE USUARIO
// ==========================================

enum UserRole {
  GERENTE
  MESERO
  COCINA
  CLIENTE
}

// ==========================================
// USUARIOS
// ==========================================

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String   @map("password_hash")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  // Rol asignado al usuario.
  role UserRole @default(CLIENTE)

  refreshTokens RefreshToken[]

  @@map("users")
}

// ==========================================
// TOKENS DE AUTENTICACIÓN
// ==========================================

model RefreshToken {
  id String @id @default(uuid()) @db.Uuid

  // Se almacena el hash SHA-256 del token.
  tokenHash String @unique @map("token_hash")

  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@map("refresh_tokens")
}

// ==========================================
// ESTADOS DE PLATILLOS
// ==========================================

enum DishStatus {
  ACTIVE
  DISABLED
  OUT_OF_STOCK
}

// ==========================================
// H1 - ACTUALIZACIÓN DE PLATILLOS
// ==========================================

model Dish {
  id          String     @id @default(uuid()) @db.Uuid
  name        String     @db.VarChar(100)
  description String?    @db.VarChar(255)
  price       Decimal    @db.Decimal(10, 2)
  categoryId  String     @map("category_id") @db.Uuid
  tags        String[]   @default([])
  status      DishStatus @default(ACTIVE)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("dishes")
}
