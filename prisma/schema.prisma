// Documentación: https://www.prisma.io/docs
//
// La URL de conexión NO vive acá: en Prisma 7 el CLI la lee desde
// prisma.config.ts y el runtime la recibe vía driver adapter (PrismaPg),
// configurado en src/prisma/services/prisma.service.ts.

generator client {
  provider = "prisma-client"

  // El cliente se genera dentro de src/.
  output = "../src/generated/prisma"

  // Query compiler en WASM, compatible con Alpine.
  engineType = "client"
  runtime    = "nodejs"

  // Configuración para ESM y TypeScript NodeNext.
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "js"
}

datasource db {
  provider = "postgresql"
}

// ==========================================
// ROLES DE USUARIO
// ==========================================

enum UserRole {
  GERENTE
  MESERO
  COCINA
  CLIENTE
}

// ==========================================
// USUARIOS
// ==========================================

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String   @map("password_hash")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  // Rol asignado al usuario.
  role UserRole @default(CLIENTE)

  refreshTokens RefreshToken[]
  staffBranches StaffBranch[]
  accountsAsCustomer Account[] @relation("AccountCustomer")
  accountsAsWaiter Account[] @relation("AccountWaiter")
  takeawayOrders Order[] @relation("TakeawayCustomer")
  inventoryMovements InventoryMovement[]
  notifications Notification[]

  @@map("users")
}

// ==========================================
// TOKENS DE AUTENTICACIÓN
// ==========================================

model RefreshToken {
  id String @id @default(uuid()) @db.Uuid

  // Se almacena el hash SHA-256 del token.
  tokenHash String @unique @map("token_hash")

  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@map("refresh_tokens")
}

// ==========================================
// ESTADOS DE PLATILLOS
// ==========================================

enum DishStatus {
  ACTIVE
  DISABLED
  OUT_OF_STOCK
}

// ==========================================
// H1 - ACTUALIZACIÓN DE PLATILLOS
// ==========================================

model Dish {
  id          String  @id @default(uuid()) @db.Uuid
  name        String  @db.VarChar(100)
  description String? @db.VarChar(255)
  price       Decimal @db.Decimal(10, 2)
  imageUrl    String? @map("image_url") @db.VarChar(500)

  // Categoría del platillo.
  categoryId String   @map("category_id") @db.Uuid
  category   Category @relation(fields: [categoryId], references: [id])

  tags   String[]   @default([])
  status DishStatus @default(ACTIVE)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Disponibilidad por sucursal.
  branchDishes BranchDish[]
  orderItems OrderItem[]

  @@map("dishes")
}

// ==========================================
// H2 - SUCURSALES
// ==========================================

model Branch {
  id       String  @id @default(uuid()) @db.Uuid
  name     String  @unique @db.VarChar(100)
  isActive Boolean @default(true) @map("is_active")
  code String? @unique @db.VarChar(12)
  openingTime String @default("07:00") @map("opening_time") @db.VarChar(5)
  closingTime String @default("22:00") @map("closing_time") @db.VarChar(5)
  takeawayCounter Int @default(0) @map("takeaway_counter")

  dishes BranchDish[]
  tables RestaurantTable[]
  staff StaffBranch[]
  accounts Account[]
  orders Order[]
  inventories BranchInventory[]
  inventoryAlerts InventoryAlert[]

  @@map("branches")
}

// ==========================================
// H2 - DISPONIBILIDAD POR SUCURSAL
// ==========================================

model BranchDish {
  branchId String @map("branch_id") @db.Uuid
  dishId   String @map("dish_id") @db.Uuid

  stockStatus DishStatus @default(ACTIVE) @map("stock_status")

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)
  dish   Dish   @relation(fields: [dishId], references: [id], onDelete: Cascade)

  @@id([branchId, dishId])
  @@map("branch_dishes")
}

// ==========================================
// CATEGORÍAS DE PLATILLOS
// ==========================================

model Category {
  id   String @id @default(uuid()) @db.Uuid
  name String @unique @db.VarChar(100)

  // Platillos pertenecientes a la categoría.
  dishes Dish[]

  @@map("categories")
}

// ==========================================
// H4 - REGISTRO DE PEDIDOS EN MESA
// ==========================================

enum TableStatus {
  FREE
  OCCUPIED
  RESERVED
}

enum AccountStatus {
  OPEN
  PAID
  VOID
}

enum OrderStatus {
  PENDING_PAYMENT
  RECEIVED
  IN_PREPARATION
  READY
  DELIVERED
  CANCELLED
}

enum OrderItemStatus {
  RECEIVED
  IN_PREPARATION
  READY
  CANCELLED
}

// Permisos del personal por sucursal, reutilizables por H5-H9.
model StaffBranch {
  userId String @map("user_id") @db.Uuid
  branchId String @map("branch_id") @db.Uuid
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@id([userId, branchId])
  @@map("staff_branches")
}

model RestaurantTable {
  id String @id @default(uuid()) @db.Uuid
  branchId String @map("branch_id") @db.Uuid
  number Int
  capacity Int
  status TableStatus @default(FREE)
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)
  accounts Account[]

  @@unique([branchId, number])
  @@map("restaurant_tables")
}

model Account {
  id String @id @default(uuid()) @db.Uuid
  branchId String @map("branch_id") @db.Uuid
  tableId String @map("table_id") @db.Uuid
  customerId String? @map("customer_id") @db.Uuid
  waiterId String @map("waiter_id") @db.Uuid
  status AccountStatus @default(OPEN)
  total Decimal @default(0) @db.Decimal(10, 2)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  branch Branch @relation(fields: [branchId], references: [id])
  table RestaurantTable @relation(fields: [tableId], references: [id])
  customer User? @relation("AccountCustomer", fields: [customerId], references: [id])
  waiter User @relation("AccountWaiter", fields: [waiterId], references: [id])
  orders Order[]

  @@index([tableId, status])
  @@map("accounts")
}

model Order {
  id String @id @default(uuid()) @db.Uuid
  accountId String? @map("account_id") @db.Uuid
  customerId String? @map("customer_id") @db.Uuid
  orderNumber String? @unique @map("order_number") @db.VarChar(40)
  branchId String @map("branch_id") @db.Uuid
  status OrderStatus @default(RECEIVED)
  total Decimal @default(0) @db.Decimal(10, 2)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  account Account? @relation(fields: [accountId], references: [id])
  customer User? @relation("TakeawayCustomer", fields: [customerId], references: [id])
  branch Branch @relation(fields: [branchId], references: [id])
  items OrderItem[]

  @@index([branchId, status, createdAt])
  @@map("orders")
}

model OrderItem {
  id String @id @default(uuid()) @db.Uuid
  orderId String @map("order_id") @db.Uuid
  dishId String @map("dish_id") @db.Uuid
  quantity Int
  notes String? @db.VarChar(100)
  unitPrice Decimal @map("unit_price") @db.Decimal(10, 2)
  imageUrl    String? @map("image_url") @db.VarChar(500)
  subtotal Decimal @db.Decimal(10, 2)
  status OrderItemStatus @default(RECEIVED)
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  dish Dish @relation(fields: [dishId], references: [id])

  @@index([orderId])
  @@map("order_items")
}

// ==========================================
// H14 - INVENTARIO DE INSUMOS
// ==========================================

enum UnitOfMeasure {
  KG
  G
  L
  ML
  UNIDAD
}

enum MovementType {
  ENTRADA
  SALIDA
}

// Catálogo único de insumos para toda la cadena.
model Supply {
  id         String        @id @default(cuid())
  name       String        @unique @db.VarChar(100)
  // Nombre en minúsculas y sin acentos, para la búsqueda de H15.
  searchName String        @map("search_name") @db.VarChar(100)
  unit       UnitOfMeasure
  createdAt  DateTime      @default(now()) @map("created_at")

  inventories BranchInventory[]
  inventoryAlerts InventoryAlert[]

  @@map("supplies")
}

// Existencias de cada insumo por sucursal.
model BranchInventory {
  id           String   @id @default(cuid())
  branchId     String   @map("branch_id") @db.Uuid
  supplyId     String   @map("supply_id")
  quantity     Decimal  @default(0) @db.Decimal(10, 3)
  minimumStock Decimal  @map("minimum_stock") @db.Decimal(10, 3)
  updatedAt    DateTime @updatedAt @map("updated_at")

  branch    Branch              @relation(fields: [branchId], references: [id], onDelete: Cascade)
  supply    Supply              @relation(fields: [supplyId], references: [id])
  movements InventoryMovement[]

  @@unique([branchId, supplyId])
  @@map("branch_inventories")
}

// Historial de entradas y salidas. No se edita ni se elimina.
model InventoryMovement {
  id                String       @id @default(cuid())
  branchInventoryId String       @map("branch_inventory_id")
  type              MovementType
  quantity          Decimal      @db.Decimal(10, 3)
  reason            String       @db.VarChar(200)
  createdById       String       @map("created_by_id") @db.Uuid
  createdAt         DateTime     @default(now()) @map("created_at")

  branchInventory BranchInventory @relation(fields: [branchInventoryId], references: [id])
  createdBy       User            @relation(fields: [createdById], references: [id])

  @@index([branchInventoryId, createdAt])
  @@map("inventory_movements")
}

// ==========================================
// H25 - NOTIFICACIONES
// ==========================================

// Módulos que generan avisos en este alcance; también filtra la bandeja (H26).
enum NotificationSource {
  COCINA
  RESERVAS
  INVENTARIO
}

enum NotificationStatus {
  NO_LEIDA
  LEIDA
}

// Las notificaciones no se borran; solo cambian de No leída a Leída.
model Notification {
  id            String             @id @default(cuid())
  recipientId   String             @map("recipient_id") @db.Uuid
  title         String             @db.VarChar(100)
  message       String             @db.VarChar(500)
  sourceModule  NotificationSource @map("source_module")
  referenceType String?            @map("reference_type") @db.VarChar(50)
  referenceId   String?            @map("reference_id")
  status        NotificationStatus @default(NO_LEIDA)
  createdAt     DateTime           @default(now()) @map("created_at")
  readAt        DateTime?          @map("read_at")

  recipient User @relation(fields: [recipientId], references: [id])

  @@index([recipientId, status, createdAt])
  @@map("notifications")
}

// H16 - Cada ciclo de escasez conserva una alerta, incluso si se atiende.
enum InventoryAlertStatus {
  ACTIVA
  ATENDIDA
}

model InventoryAlert {
  id              String               @id @default(cuid())
  branchId        String               @map("branch_id") @db.Uuid
  supplyId        String               @map("supply_id")
  quantityAtAlert Decimal              @map("quantity_at_alert") @db.Decimal(10, 3)
  status          InventoryAlertStatus @default(ACTIVA)
  cycleOpen       Boolean              @default(true) @map("cycle_open")
  createdAt       DateTime             @default(now()) @map("created_at")
  branch          Branch               @relation(fields: [branchId], references: [id], onDelete: Cascade)
  supply          Supply               @relation(fields: [supplyId], references: [id])

  @@index([branchId, status, createdAt])
  @@map("inventory_alerts")
}
