// Documentación: https://www.prisma.io/docs
//
// La URL de conexión NO vive acá: en Prisma 7 el CLI la lee desde
// prisma.config.ts y el runtime la recibe vía driver adapter (PrismaPg),
// configurado en src/prisma/services/prisma.service.ts.

generator client {
  provider = "prisma-client"
  output = "../src/generated/prisma"
  engineType = "client"
  runtime = "nodejs"
  moduleFormat = "esm"
  generatedFileExtension = "ts"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// ==========================================
// ROLES DE USUARIO
// ==========================================

enum UserRole {
  GERENTE
  MESERO
  COCINA
  CLIENTE
  GERENTE_GENERAL
}

// ==========================================
// USUARIOS
// ==========================================

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String   @map("password_hash")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  role UserRole @default(CLIENTE)

  refreshTokens      RefreshToken[]
  staffBranches      StaffBranch[]
  accountsAsCustomer Account[]           @relation("AccountCustomer")
  accountsAsWaiter   Account[]           @relation("AccountWaiter")
  takeawayOrders     Order[]             @relation("TakeawayCustomer")
  paymentsProcessed Payment[]            @relation("PaymentProcessedBy")
  inventoryMovements InventoryMovement[]
  notifications      Notification[]
  reservations       Reservation[]
  loyaltyRuleChanges     LoyaltyRuleHistory[]
  loyaltyBenefitsCreated LoyaltyBenefit[] @relation("LoyaltyBenefitCreator")
  reviews            Review[]

  // H20 - Cuenta de puntos del cliente
  loyaltyAccount LoyaltyAccount?

  @@map("users")
}

// ==========================================
// TOKENS DE AUTENTICACIÓN
// ==========================================

model RefreshToken {
  id String @id @default(uuid()) @db.Uuid
  tokenHash String @unique @map("token_hash")
  userId String @map("user_id") @db.Uuid
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("refresh_tokens")
}

// ==========================================
// ESTADOS DE PLATILLOS
// ==========================================

enum DishStatus {
  ACTIVE
  DISABLED
  OUT_OF_STOCK
}

// ==========================================
// H1 - ACTUALIZACIÓN DE PLATILLOS
// ==========================================

model Dish {
  id          String  @id @default(uuid()) @db.Uuid
  name        String  @db.VarChar(100)
  description String? @db.VarChar(255)
  price       Decimal @db.Decimal(10, 2)
  imageUrl    String? @map("image_url") @db.VarChar(500)

  categoryId String   @map("category_id") @db.Uuid
  category   Category @relation(fields: [categoryId], references: [id])

  tags   String[]   @default([])
  status DishStatus @default(ACTIVE)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  branchDishes BranchDish[]
  orderItems   OrderItem[]

  @@map("dishes")
}

// ==========================================
// H2 - SUCURSALES
// ==========================================

model Branch {
  id              String  @id @default(uuid()) @db.Uuid
  name            String  @unique @db.VarChar(100)
  isActive        Boolean @default(true) @map("is_active")
  code            String? @unique @db.VarChar(12)
  openingTime     String  @default("07:00") @map("opening_time") @db.VarChar(5)
  closingTime     String  @default("22:00") @map("closing_time") @db.VarChar(5)
  takeawayCounter Int     @default(0) @map("takeaway_counter")
  receiptCounter Int @default(0) @map("receipt_counter")

  dishes          BranchDish[]
  tables          RestaurantTable[]
  staff           StaffBranch[]
  accounts        Account[]
  orders          Order[]
  inventories     BranchInventory[]
  inventoryAlerts InventoryAlert[]
  reservations    Reservation[]
  payments        Payment[]
  receipts        Receipt[]
  reviews         Review[]

  @@map("branches")
}

// ==========================================
// H2 - DISPONIBILIDAD POR SUCURSAL
// ==========================================

model BranchDish {
  branchId String @map("branch_id") @db.Uuid
  dishId   String @map("dish_id") @db.Uuid

  stockStatus DishStatus @default(ACTIVE) @map("stock_status")

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)
  dish   Dish   @relation(fields: [dishId], references: [id], onDelete: Cascade)

  @@id([branchId, dishId])
  @@map("branch_dishes")
}

// ==========================================
// CATEGORÍAS DE PLATILLOS
// ==========================================

model Category {
  id   String @id @default(uuid()) @db.Uuid
  name String @unique @db.VarChar(100)

  dishes Dish[]

  @@map("categories")
}

// ==========================================
// H4 - REGISTRO DE PEDIDOS EN MESA
// ==========================================

enum TableStatus {
  FREE
  OCCUPIED
  RESERVED
}

enum AccountStatus {
  OPEN
  PAID
  VOID
}

enum PaymentMethod {
  CASH
  CARD
}

enum PaymentStatus {
  APPROVED
  REJECTED
}

enum OrderStatus {
  PENDING_PAYMENT
  RECEIVED
  IN_PREPARATION
  READY
  DELIVERED
  CANCELLED
}

enum OrderItemStatus {
  RECEIVED
  IN_PREPARATION
  READY
  CANCELLED
}

enum ReservationStatus {
  CONFIRMED
  COMPLETED
  CANCELLED
}

// Permisos del personal por sucursal, reutilizables por H5-H9.
model StaffBranch {
  userId   String @map("user_id") @db.Uuid
  branchId String @map("branch_id") @db.Uuid
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@id([userId, branchId])
  @@map("staff_branches")
}

model RestaurantTable {
  id           String        @id @default(uuid()) @db.Uuid
  branchId     String        @map("branch_id") @db.Uuid
  number       Int
  capacity     Int
  status       TableStatus   @default(FREE)
  branch       Branch        @relation(fields: [branchId], references: [id], onDelete: Cascade)
  accounts     Account[]
  reservations Reservation[]

  @@unique([branchId, number])
  @@map("restaurant_tables")
}

// H10 - REGISTRO DE RESERVAS
model Reservation {
  id              String            @id @default(uuid()) @db.Uuid
  userId          String            @map("user_id") @db.Uuid
  branchId        String            @map("branch_id") @db.Uuid
  tableId         String            @map("table_id") @db.Uuid
  dateTime        DateTime          @map("date_time")
  durationMinutes Int               @default(90) @map("duration_minutes")
  peopleCount     Int               @map("people_count")
  status          ReservationStatus @default(CONFIRMED)
  createdAt       DateTime          @default(now()) @map("created_at")

  user   User            @relation(fields: [userId], references: [id])
  branch Branch          @relation(fields: [branchId], references: [id])
  table  RestaurantTable @relation(fields: [tableId], references: [id])

  @@index([userId, status])
  @@index([branchId, dateTime, status])
  @@index([tableId, dateTime, status])
  @@map("reservations")
}

model Account {
  id         String          @id @default(uuid()) @db.Uuid
  branchId   String          @map("branch_id") @db.Uuid
  tableId    String          @map("table_id") @db.Uuid
  customerId String?         @map("customer_id") @db.Uuid
  waiterId   String          @map("waiter_id") @db.Uuid
  status     AccountStatus   @default(OPEN)
  total      Decimal         @default(0) @db.Decimal(10, 2)
  createdAt  DateTime        @default(now()) @map("created_at")
  updatedAt  DateTime        @updatedAt @map("updated_at")
  branch     Branch          @relation(fields: [branchId], references: [id])
  table      RestaurantTable @relation(fields: [tableId], references: [id])
  customer   User?           @relation("AccountCustomer", fields: [customerId], references: [id])
  waiter     User            @relation("AccountWaiter", fields: [waiterId], references: [id])
  orders     Order[]
  payments Payment[]
  receipt  Receipt?
  loyaltyRedemptions LoyaltyRedemption[]
  review   Review?

  @@index([tableId, status])
  @@map("accounts")
}

model Order {
  id          String      @id @default(uuid()) @db.Uuid
  accountId   String?     @map("account_id") @db.Uuid
  customerId  String?     @map("customer_id") @db.Uuid
  orderNumber String?     @unique @map("order_number") @db.VarChar(40)
  branchId    String      @map("branch_id") @db.Uuid
  status      OrderStatus @default(RECEIVED)
  total       Decimal     @default(0) @db.Decimal(10, 2)
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")
  account     Account?    @relation(fields: [accountId], references: [id])
  customer    User?       @relation("TakeawayCustomer", fields: [customerId], references: [id])
  branch      Branch      @relation(fields: [branchId], references: [id])
  items       OrderItem[]
  review Review?
  payments    Payment[]
  receipt     Receipt?
  loyaltyRedemptions LoyaltyRedemption[]

  @@index([branchId, status, createdAt])
  @@map("orders")
}

model OrderItem {
  id        String          @id @default(uuid()) @db.Uuid
  orderId   String          @map("order_id") @db.Uuid
  dishId    String          @map("dish_id") @db.Uuid
  quantity  Int
  notes     String?         @db.VarChar(100)
  unitPrice Decimal         @map("unit_price") @db.Decimal(10, 2)
  imageUrl  String?         @map("image_url") @db.VarChar(500)
  subtotal  Decimal         @db.Decimal(10, 2)
  status    OrderItemStatus @default(RECEIVED)
  order     Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  dish      Dish            @relation(fields: [dishId], references: [id])

  @@index([orderId])
  @@map("order_items")
}

// ==========================================
// H14 - INVENTARIO DE INSUMOS
// ==========================================

enum UnitOfMeasure {
  KG
  G
  L
  ML
  UNIDAD
}

enum MovementType {
  ENTRADA
  SALIDA
}

model Supply {
  id String @id @default(cuid())
  name String @unique @db.VarChar(100)
  searchName String @map("search_name") @db.VarChar(100)
  unit UnitOfMeasure
  createdAt DateTime @default(now()) @map("created_at")

  inventories     BranchInventory[]
  inventoryAlerts InventoryAlert[]

  @@map("supplies")
}
// ==========================================
// H18 - PAGOS Y COMPROBANTES
// ==========================================

model Payment {
  id             String        @id @default(uuid()) @db.Uuid
  branchId       String        @map("branch_id") @db.Uuid
  accountId      String?       @map("account_id") @db.Uuid
  orderId        String?       @map("order_id") @db.Uuid
  userId         String        @map("user_id") @db.Uuid

  method         PaymentMethod
  status         PaymentStatus @default(APPROVED)

  amount         Decimal       @db.Decimal(10, 2)
  amountReceived Decimal?      @map("amount_received") @db.Decimal(10, 2)
  change         Decimal       @default(0) @db.Decimal(10, 2)

  cardLast4      String?       @map("card_last4") @db.VarChar(4)

  createdAt      DateTime      @default(now()) @map("created_at")

  branch         Branch        @relation(fields: [branchId], references: [id])
  account        Account?      @relation(fields: [accountId], references: [id])
  order          Order?        @relation(fields: [orderId], references: [id])
  user           User          @relation("PaymentProcessedBy", fields: [userId], references: [id])

  receipt        Receipt?
  loyaltyRedemption LoyaltyRedemption?

  @@index([accountId, status])
  @@index([orderId, status])
  @@index([branchId, createdAt])
  @@map("payments")
}

model Receipt {
  id            String   @id @default(uuid()) @db.Uuid
  branchId      String   @map("branch_id") @db.Uuid
  paymentId     String   @unique @map("payment_id") @db.Uuid

  accountId     String?  @unique @map("account_id") @db.Uuid
  orderId       String?  @unique @map("order_id") @db.Uuid

  receiptNumber Int      @map("receipt_number")
  issuedAt      DateTime @default(now()) @map("issued_at")

  subtotal      Decimal  @db.Decimal(10, 2)
  discount      Decimal  @default(0) @db.Decimal(10, 2)
  tax           Decimal  @db.Decimal(10, 2)
  total         Decimal  @db.Decimal(10, 2)

  paymentMethod PaymentMethod @map("payment_method")

  items         Json

  branch        Branch  @relation(fields: [branchId], references: [id])
  payment       Payment @relation(fields: [paymentId], references: [id])
  account       Account? @relation(fields: [accountId], references: [id])
  order         Order?   @relation(fields: [orderId], references: [id])

  @@unique([branchId, receiptNumber])
  @@map("receipts")
}

model BranchInventory {
  id String @id @default(cuid())
  branchId String @map("branch_id") @db.Uuid
  supplyId String @map("supply_id")
  quantity Decimal @default(0) @db.Decimal(10, 3)
  minimumStock Decimal @map("minimum_stock") @db.Decimal(10, 3)
  updatedAt DateTime @updatedAt @map("updated_at")

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)
  supply Supply @relation(fields: [supplyId], references: [id])
  movements InventoryMovement[]

  @@unique([branchId, supplyId])
  @@map("branch_inventories")
}

model InventoryMovement {
  id String @id @default(cuid())
  branchInventoryId String @map("branch_inventory_id")
  type MovementType
  quantity Decimal @db.Decimal(10, 3)
  reason String @db.VarChar(200)
  createdById String @map("created_by_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  branchInventory BranchInventory @relation(fields: [branchInventoryId], references: [id])
  createdBy User @relation(fields: [createdById], references: [id])

  @@index([branchInventoryId, createdAt])
  @@map("inventory_movements")
}

// ==========================================
// H25 - NOTIFICACIONES
// ==========================================

enum NotificationSource {
  COCINA
  RESERVAS
  INVENTARIO
}

enum NotificationStatus {
  NO_LEIDA
  LEIDA
}

model Notification {
  id String @id @default(cuid())
  recipientId String @map("recipient_id") @db.Uuid
  title String @db.VarChar(100)
  message String @db.VarChar(500)
  sourceModule NotificationSource @map("source_module")
  referenceType String? @map("reference_type") @db.VarChar(50)
  referenceId String? @map("reference_id")
  status NotificationStatus @default(NO_LEIDA)
  createdAt DateTime @default(now()) @map("created_at")
  readAt DateTime? @map("read_at")

  recipient User @relation(fields: [recipientId], references: [id])

  @@index([recipientId, status, createdAt])
  @@map("notifications")
}

// H16 - ALERTAS DE INVENTARIO
enum InventoryAlertStatus {
  ACTIVA
  ATENDIDA
}

model InventoryAlert {
  id String @id @default(cuid())
  branchId String @map("branch_id") @db.Uuid
  supplyId String @map("supply_id")
  quantityAtAlert Decimal @map("quantity_at_alert") @db.Decimal(10, 3)
  status InventoryAlertStatus @default(ACTIVA)
  cycleOpen Boolean @default(true) @map("cycle_open")
  createdAt DateTime @default(now()) @map("created_at")
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)
  supply Supply @relation(fields: [supplyId], references: [id])

  @@index([branchId, status, createdAt])
  @@map("inventory_alerts")
}

// ==========================================
// H20 - ACUMULACION DE PUNTOS
// ==========================================

enum LoyaltyMovementType {
  EARNED
}

model LoyaltyAccount {
  id String @id @default(uuid()) @db.Uuid
  userId String @unique @map("user_id") @db.Uuid
  // Total points owned by the customer, including reserved points.
  balance Int @default(0)
  // Reserved points are included in balance; available = balance - reservedPoints.
  reservedPoints Int @default(0) @map("reserved_points")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  movements LoyaltyMovement[]
  redemptions LoyaltyRedemption[]
  redemptionMovements LoyaltyRedemptionMovement[]

  @@map("loyalty_accounts")
}

model LoyaltyMovement {
  id String @id @default(uuid()) @db.Uuid
  loyaltyAccountId String @map("loyalty_account_id") @db.Uuid
  type LoyaltyMovementType
  points Int
  paymentReference String @unique @map("payment_reference")
  description String? @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at")

  loyaltyAccount LoyaltyAccount @relation(fields: [loyaltyAccountId], references: [id], onDelete: Cascade)

  @@index([loyaltyAccountId, createdAt])
  @@map("loyalty_movements")
}

// ==========================================
// H22 - CONFIGURACIÓN DEL PROGRAMA DE LEALTAD
// ==========================================

enum LoyaltyDiscountType {
  PERCENTAGE
  FIXED
}

model LoyaltyRule {
  id              String   @id @default(uuid()) @db.Uuid
  pointsPerDollar Decimal  @default(1) @map("points_per_dollar") @db.Decimal(10, 2)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  history LoyaltyRuleHistory[]

  @@map("loyalty_rules")
}

model LoyaltyRuleHistory {
  id                String   @id @default(uuid()) @db.Uuid
  loyaltyRuleId     String   @map("loyalty_rule_id") @db.Uuid
  previousPoints    Decimal  @map("previous_points") @db.Decimal(10, 2)
  newPoints         Decimal  @map("new_points") @db.Decimal(10, 2)
  changedById       String   @map("changed_by_id") @db.Uuid
  changedAt         DateTime @default(now()) @map("changed_at")

  loyaltyRule LoyaltyRule @relation(fields: [loyaltyRuleId], references: [id])
  changedBy   User        @relation(fields: [changedById], references: [id])

  @@index([loyaltyRuleId, changedAt])
  @@map("loyalty_rule_history")
}

model LoyaltyBenefit {
  id             String              @id @default(uuid()) @db.Uuid
  name           String              @unique @db.VarChar(100)
  pointsRequired Int                 @map("points_required")
  discountType   LoyaltyDiscountType @map("discount_type")
  discountValue  Decimal             @map("discount_value") @db.Decimal(10, 2)
  active         Boolean             @default(true)
  createdById    String              @map("created_by_id") @db.Uuid
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")

  createdBy   User                @relation("LoyaltyBenefitCreator", fields: [createdById], references: [id])
  redemptions LoyaltyRedemption[]

  @@index([active, pointsRequired])
  @@map("loyalty_benefits")
}

// ==========================================
// H21 - CANJES DE PUNTOS
// ==========================================

enum LoyaltyRedemptionStatus {
  RESERVED
  COMPLETED
  RELEASED
}

enum LoyaltyRedemptionReleaseReason {
  PAYMENT_REJECTED
  CANCELLED
  EXPIRED
}

enum LoyaltyRedemptionMovementType {
  RESERVED
  SPENT
  RELEASED
}

model LoyaltyRedemption {
  id               String                        @id @default(uuid()) @db.Uuid
  loyaltyAccountId String                        @map("loyalty_account_id") @db.Uuid
  benefitId        String                        @map("benefit_id") @db.Uuid
  accountId        String?                       @map("account_id") @db.Uuid
  orderId          String?                       @map("order_id") @db.Uuid
  paymentId        String?                       @unique @map("payment_id") @db.Uuid
  pointsReserved   Int                           @map("points_reserved")
  subtotalAmount   Decimal                       @map("subtotal_amount") @db.Decimal(10, 2)
  discountAmount   Decimal                       @map("discount_amount") @db.Decimal(10, 2)
  status           LoyaltyRedemptionStatus       @default(RESERVED)
  releaseReason    LoyaltyRedemptionReleaseReason? @map("release_reason")
  expiresAt        DateTime                      @default(dbgenerated("CURRENT_TIMESTAMP + INTERVAL '15 minutes'")) @map("expires_at")
  createdAt        DateTime                      @default(now()) @map("created_at")
  updatedAt        DateTime                      @updatedAt @map("updated_at")
  completedAt      DateTime?                     @map("completed_at")
  releasedAt       DateTime?                     @map("released_at")

  loyaltyAccount LoyaltyAccount @relation(fields: [loyaltyAccountId], references: [id], onDelete: Restrict)
  benefit        LoyaltyBenefit @relation(fields: [benefitId], references: [id], onDelete: Restrict)
  account        Account?        @relation(fields: [accountId], references: [id], onDelete: Restrict)
  order          Order?          @relation(fields: [orderId], references: [id], onDelete: Restrict)
  payment        Payment?        @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  movements      LoyaltyRedemptionMovement[]

  @@index([loyaltyAccountId, status, expiresAt])
  @@index([benefitId, status])
  @@index([accountId, status])
  @@index([orderId, status])
  @@map("loyalty_redemptions")
}

model LoyaltyRedemptionMovement {
  id               String                         @id @default(uuid()) @db.Uuid
  redemptionId     String                         @map("redemption_id") @db.Uuid
  loyaltyAccountId String                         @map("loyalty_account_id") @db.Uuid
  type             LoyaltyRedemptionMovementType
  points           Int
  idempotencyKey   String                         @unique @map("idempotency_key") @db.VarChar(100)
  createdAt        DateTime                       @default(now()) @map("created_at")

  redemption     LoyaltyRedemption @relation(fields: [redemptionId], references: [id], onDelete: Restrict)
  loyaltyAccount LoyaltyAccount    @relation(fields: [loyaltyAccountId], references: [id], onDelete: Restrict)

  @@unique([redemptionId, type])
  @@index([loyaltyAccountId, createdAt])
  @@map("loyalty_redemption_movements")
}

// RESEÑAS (Módulo 8, H23) — modelo creado para H30 con los campos
// definidos en el documento de historias. Una reseña por compra:
// la cuenta de mesa o el pedido para llevar.
// ==========================================

model Review {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  accountId String?  @unique @map("account_id") @db.Uuid
  orderId   String?  @unique @map("order_id") @db.Uuid
  branchId  String   @map("branch_id") @db.Uuid
  rating    Int
  comment   String?  @db.VarChar(500)
  createdAt DateTime @default(now()) @map("created_at")

  user    User     @relation(fields: [userId], references: [id])
  account Account? @relation(fields: [accountId], references: [id])
  order   Order?   @relation(fields: [orderId], references: [id])
  branch  Branch   @relation(fields: [branchId], references: [id])

  @@index([branchId, createdAt])
  @@map("reviews")
}
